# HU-03: casos de prueba de la especificacion (spec.md). Ejecutar de arriba abajo con la aplicacion recien arrancada.
#
# Not covered here (se comprueban en las pruebas automaticas):
#   US2-3, FR-003  token vencido y limite exacto: TokenRequiredApiTest, TokenExpiryValidatorTest
#   US2-2          token firmado con otra clave y token sin exp: TokenRequiredApiTest
#   Edge Token sin rol reconocido: RoleAccessApiTest
#   FR-006, FR-007 usuarios de demostracion y resumenes BCrypt: AuthLoginApiTest, UserPersistenceAdapterTest
#   FR-008, FR-009 arranque sin clave o contrasenas: StartupConfigurationTest
#   FR-015 sin sesion ni cookies: AuthLoginApiTest, TokenRequiredApiTest
#   FR-019 sin bloqueos: PlaylistNonBlockingTest
#   SC-005 tiempo del inicio de sesion: PlaylistPerformanceTest

@baseUrl = http://localhost:8080
# Los valores de DEMO_USER_PASSWORD y DEMO_ADMIN_PASSWORD. No guardarlos en el repositorio.
@userPassword = <contrasena-user>
@adminPassword = <contrasena-admin>

### US1-1 / FR-001, FR-002, FR-003: inicio de sesion de user, vigencia 1800 — expects 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username": "user", "password": "{{userPassword}}"}

> {%
client.test("status 200", () => client.assert(response.status === 200));
client.test("Bearer token of 30 minutes", () => client.assert(response.body.tokenType === "Bearer" && response.body.expiresIn === 1800));
client.global.set("userToken", response.body.accessToken);
%}

### US1-2 / FR-001: inicio de sesion de admin — expects 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username": "admin", "password": "{{adminPassword}}"}

> {%
client.test("status 200", () => client.assert(response.status === 200));
client.global.set("adminToken", response.body.accessToken);
%}

### Edge Inicio de sesion con un token previo invalido / FR-010 — expects 200
POST {{baseUrl}}/auth/login
Authorization: Bearer abc
Content-Type: application/json

{"username": "admin", "password": "{{adminPassword}}"}

> {% client.test("status 200", () => client.assert(response.status === 200)); %}

