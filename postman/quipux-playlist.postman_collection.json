              "raw": "{\n  \"nombre\": \"Lista con genero desconocido\",\n  \"descripcion\": \"Creada por la coleccion\",\n  \"canciones\": [\n    {\"titulo\": \"Cancion de ejemplo\", \"artista\": \"Artista\", \"album\": \"Album\", \"anno\": \"1999\", \"genero\": \"genero-que-no-existe\"}\n  ]\n}",
              "options": {
